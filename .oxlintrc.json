{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/"
  ],
  "options": {
    "maxWarnings": 10
  },
  "plugins": [
    "import",
    "eslint",
    "promise",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "perf": "error",
  },
  "rules": {
    "require-await": "error"
  },
  "env": {
    "builtin": true
  }
}